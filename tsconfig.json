{
  "compilerOptions": {
    "outDir": "build/dist",
    "module": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "sourceMap": true,
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "exclude": [
    "coverage",
    "examples",
    "dist",
    "dist-es",
    "node_modules",
    "src/tests"
  ]
}
