{
  "name": "airdcpp-extension",
  "version": "2.0.0-beta.2",
  "description": "AirDC++ extension development modules for JavaScript",
  "exports": "./dist-es/index.js",
  "scripts": {
    "build": "npm run build-es",
    "build-es": "rimraf dist-es && cross-env NODE_ENV=production tsc -d --outDir dist-es",
    "clean": "rimraf dist/* && rimraf dist-es/*",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airdcpp-web/airdcpp-extension-js"
  },
  "keywords": [
    "airdcpp",
    "airdcpp-extensions"
  ],
  "dependencies": {
    "airdcpp-apisocket": "^3.0.0-beta",
    "chalk": "^5.0.1",
    "minimist": "^1.2.6",
    "mkdirp": "^3.0.1",
    "websocket": "^1.0.34"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.21.4",
    "@types/jest": "^30.0.0",
    "@types/minimist": "^1.2.2",
    "@types/mkdirp": "^1.0.2",
    "@types/node": "^24.1.0",
    "@types/websocket": "^1.0.5",
    "airdcpp-extension-settings": "^1.2.1",
    "cross-env": "^10.0.0",
    "jest": "^30.0.5",
    "jest-cli": "^30.0.5",
    "pre-commit": "^1.2.2",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.2",
    "wait-for-expect": "^4.0.0"
  },
  "pre-commit": [
    "test"
  ],
  "type": "module",
  "author": "maksis",
  "license": "MIT",
  "airdcpp": {
    "apiVersion": 1,
    "minApiFeatureLevel": 0
  }
}
